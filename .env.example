# Copy to `.env` and fill in your values. `.env` is gitignored — never commit real credentials.
# These are loaded automatically (via python-dotenv) by the CLI and the scripts/ helpers.

# Locale of your Lidl Plus account.
LIDL_LANGUAGE=de            # de, en, fr, it, ...
LIDL_COUNTRY=DE             # DE, AT, FR, BE, NL, ...

# Login credentials — only needed to MINT a refresh token (see docs/authentication.md).
# You type the password yourself in your browser during the manual login flow.
LIDL_EMAIL=your_email@example.com
LIDL_PASSWORD=your_password

# Refresh token — the durable, headless credential used for all normal runs.
# This is a 64-char hex REFRESH token (not an access/bearer token). Obtain it once
# via scripts/get_login_url.py + scripts/exchange_code.py, then keep it alive with
# scripts/refresh_keepalive.py (Lidl rotates it on each renewal).
LIDLPLUS_TOKEN=
